# Copia este archivo como .env para desarrollo local.
FLASK_ENV=development
PORT=5000

# Cambia estos valores antes de publicar. Usa claves largas y únicas.
SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_LARGA_Y_ALEATORIA
ADMIN_REGISTRATION_KEY=CAMBIA_ESTA_CLAVE_DE_ADMINISTRADOR

# Base de datos persistente para producción (PostgreSQL recomendado).
# Ejemplo: postgresql://usuario:password@host:5432/caramell_momen
DATABASE_URL=

# Opcional: asistente de Google Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
